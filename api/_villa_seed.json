  "about": {
    "chapter": "Chapter II",
    "kicker": "The space",
    "title_pre": "Where ",
    "title_em": "family memories",
    "title_post": " are made",
    "hook": "Gather your whole family on 4,000 m² of private garden — sauna, hot tub under the stars, a boat and ancient oaks. Room to be together, space to breathe apart.",
    "blocks": [
      {
        "heading": "The space",
        "text": "Preikestolen Villa is a spacious private villa for families and groups who want to experience Rogaland properly — with room to breathe, genuine privacy, and everything you need for an unforgettable stay. Set on approximately 4,000 m² of land with manicured gardens, ancient oak trees, a greenhouse, a stream, and multiple outdoor areas. Plenty of space to be together — and room to find your own corner of quiet."
      },
      {
        "heading": "Highlights",
        "items": [
          "Wood-fired Skargards Regal 220 hot tub (8–10 guests)",
          "Private sauna",
          "Fire barrel and three indoor fireplaces",
          "Fully equipped kitchen with dining for 12",
          "Loft lounge with 65\" TV + additional TV on main floor",
          "Five bedrooms + loft",
          "14-foot boat with 9.9 hp motor (April–November, by arrangement)",
          "Large garden with terraces, seating areas and stream"
        ]
      },
      {
        "heading": "Sleeping arrangements",
        "text": "Comfortable beds for 12 adults in standard bedrooms. With additional sleeping options, up to 15 guests can be accommodated in total.",
        "heading2": "Location",
        "text2": "Quiet neighbourhood with minimal traffic and excellent privacy — just 25 minutes from Preikestolen and the Lysefjord."
      },
      {
        "heading": "Best suited for",
        "text": "Family holidays, multi-generational trips, groups of friends, and work retreats needing space and tranquility. This villa is best suited for guests who value peace, nature and quality time together — not for events or parties."
      },
      {
        "heading": "Guest access",
        "text": "Guests have full and private access to the entire villa, including the garden, terrace and all outdoor areas. Only a few storage rooms and the garage are locked and not available during the stay."
      }
    ]
  },
